.plan-emoji {
  flex: none;
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  margin-right: 22rpx;
}

.item-main {
  padding-right: 16rpx;
}

.item-name {
  font-size: 31rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}

.streak-tag {
  margin-left: 14rpx;
  flex: none;
}

.item-meta {
  font-size: 23rpx;
  color: var(--sub);
  margin-top: 8rpx;
}

.del-btn {
  flex: none;
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.del-btn:active {
  opacity: 0.7;
}

.add-btn {
  margin-top: 40rpx;
}

.hint {
  text-align: center;
  margin-top: 24rpx;
  line-height: 1.7;
}
